#include <iostream>
#include <string>
#include <bitset>
using namespace std;

// XOR operation for CRC division
string xorOperation(string a, string b) {
    string result = "";

    for (int i = 1; i < b.length(); i++) {
        result += (a[i] == b[i]) ? '0' : '1';
    }

    return result;
}

// Perform modulo-2 division
string mod2Division(string dividend, string divisor) {
    int divisorLength = divisor.length();
    string temp = dividend.substr(0, divisorLength);

    int index = divisorLength;

    while (index < dividend.length()) {
        if (temp[0] == '1') {
            temp = xorOperation(temp, divisor);
        } else {
            temp = xorOperation(temp, string(divisorLength, '0'));
        }

        temp += dividend[index];
        index++;
    }

    // Final XOR
    if (temp[0] == '1') {
        temp = xorOperation(temp, divisor);
    } else {
        temp = xorOperation(temp, string(divisorLength, '0'));
    }

    return temp;
}

// Convert ASCII text to binary
string asciiToBinary(string text) {
    string binary = "";

    for (char c : text) {
        binary += bitset<8>(c).to_string();
    }

    return binary;
}

// Check whether remainder is zero
bool checkCRC(string data, string generator) {
    string remainder = mod2Division(data, generator);

    for (char bit : remainder) {
        if (bit == '1')
            return false;
    }

    return true;
}

int main() {

    string text, generator;

    cout << "Enter ASCII data: ";
    getline(cin, text);

    cout << "Enter generator polynomial in binary: ";
    cin >> generator;

    // Convert ASCII data to binary
    string data = asciiToBinary(text);

    cout << "\nASCII Data in Binary: " << data << endl;

    // Append zeros
    int zeros = generator.length() - 1;
    string appendedData = data + string(zeros, '0');

    // Calculate CRC
    string crc = mod2Division(appendedData, generator);

    cout << "CRC Bits: " << crc << endl;

    // Codeword
    string transmittedData = data + crc;

    cout << "Transmitted Data: " << transmittedData << endl;

    // ------------------------------------------------
    // Introduce an error
    // ------------------------------------------------

    int errorPosition;

    cout << "\nEnter bit position to introduce error (1-" 
         << transmittedData.length() << ", 0 for no error): ";

    cin >> errorPosition;

    string receivedData = transmittedData;

    if (errorPosition != 0 &&
        errorPosition <= transmittedData.length()) {

        int index = errorPosition - 1;

        // Flip the bit
        receivedData[index] =
            (receivedData[index] == '0') ? '1' : '0';

        cout << "\nError introduced at bit position: "
             << errorPosition << endl;
    }

    cout << "Received Data: " << receivedData << endl;

    // ------------------------------------------------
    // CRC Error Detection
    // ------------------------------------------------

    if (checkCRC(receivedData, generator)) {

        cout << "\nNo error detected by CRC." << endl;

    } else {

        cout << "\nError detected by CRC!" << endl;

        // ------------------------------------------------
        // Error Correction
        // ------------------------------------------------

        bool corrected = false;

        for (int i = 0; i < receivedData.length(); i++) {

            string temp = receivedData;

            // Flip one bit
            temp[i] = (temp[i] == '0') ? '1' : '0';

            if (checkCRC(temp, generator)) {

                cout << "Error corrected at bit position: "
                     << i + 1 << endl;

                receivedData = temp;
                corrected = true;

                break;
            }
        }

        if (corrected) {
            cout << "Corrected Data: "
                 << receivedData << endl;
        } else {
            cout << "Error could not be corrected." << endl;
        }
    }

    return 0;
}
