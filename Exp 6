#include <iostream>
#include <string>

using namespace std;

struct Student {
    int rollNo;
    string name;
    Student* left;
    Student* right;

    Student(int roll, string studentName) {
        rollNo = roll;
        name = studentName;
        left = nullptr;
        right = nullptr;
    }
};

// Insert a student record
Student* insertStudent(Student* root, int rollNo, string name) {
    if (root == nullptr) return new Student(rollNo, name);

    if (rollNo < root->rollNo)
        root->left = insertStudent(root->left, rollNo, name);
    else if (rollNo > root->rollNo)
        root->right = insertStudent(root->right, rollNo, name);
    else
        cout << "Roll number already exists." << endl;

    return root;
}

// Search for a student
Student* searchStudent(Student* root, int rollNo) {
    if (root == nullptr || root->rollNo == rollNo)
        return root;

    if (rollNo < root->rollNo)
        return searchStudent(root->left, rollNo);

    return searchStudent(root->right, rollNo);
}

// Find minimum node
Student* findMin(Student* root) {
    Student* current = root;
    while (current != nullptr && current->left != nullptr)
        current = current->left;
    return current;
}

// Delete a student record
Student* deleteStudent(Student* root, int rollNo) {
    if (root == nullptr) return root;

    if (rollNo < root->rollNo) {
        root->left = deleteStudent(root->left, rollNo);
    } else if (rollNo > root->rollNo) {
        root->right = deleteStudent(root->right, rollNo);
    } else {
        // No left child
        if (root->left == nullptr) {
            Student* temp = root->right;
            delete root;
            return temp;
        }
        // No right child
        if (root->right == nullptr) {
            Student* temp = root->left;
            delete root;
            return temp;
        }

        // Two children
        Student* temp = findMin(root->right);
        root->rollNo = temp->rollNo;
        root->name = temp->name; // Fixed missing semicolon here
        root->right = deleteStudent(root->right, temp->rollNo);
    }
    return root;
}

// Display records in sorted order
void inorder(Student* root) {
    if (root == nullptr) return;

    inorder(root->left);
    cout << "Roll No: " << root->rollNo << ", Name: " << root->name << endl;
    inorder(root->right);
}

int main() {
    Student* root = nullptr;
    int choice, rollNo;
    string name; // Fixed missing semicolon here

    do {
        cout << "\n--- Student Record BST ---" << endl;
        cout << "1. Insert Student" << endl;
        cout << "2. Search Student" << endl;
        cout << "3. Delete Student" << endl;
        cout << "4. Display Students" << endl;
        cout << "5. Exit" << endl;
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter roll number: ";
                cin >> rollNo;
                cout << "Enter student name: ";
                cin >> name;
                root = insertStudent(root, rollNo, name);
                cout << "Student record inserted successfully." << endl;
                break;

            case 2:
                cout << "Enter roll number to search: ";
                cin >> rollNo;
                {
                    Student* result = searchStudent(root, rollNo);
                    if (result != nullptr) {
                        cout << "Student found!" << endl;
                        cout << "Roll No: " << result->rollNo << endl;
                        cout << "Name: " << result->name << endl;
                    } else {
                        cout << "Student not found." << endl;
                    }
                }
                break;

            case 3:
                cout << "Enter roll number to delete: ";
                cin >> rollNo;
                if (searchStudent(root, rollNo) != nullptr) {
                    root = deleteStudent(root, rollNo);
                    cout << "Student record deleted successfully." << endl;
                } else {
                    cout << "Student not found." << endl;
                }
                break;

            case 4:
                cout << "\nStudent Records in Sorted Order:" << endl;
                inorder(root);
                break;

            case 5:
                cout << "Exiting program. Goodbye!" << endl;
                break;

            default:
                cout << "Invalid choice. Please try again." << endl;
        }
    } while (choice != 5);

    return 0;
}
